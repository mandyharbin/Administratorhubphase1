{
  "resourceType": "Questionnaire",
  "id": "Q-002",
  "url": "https://greenwayhealth.com/fhir/Questionnaire/financial-consent",
  "version": "1.5",
  "name": "FinancialConsent",
  "title": "Financial Consent Form",
  "status": "active",
  "date": "2025-10-22",
  "publisher": "Greenway Health",
  "description": "Financial responsibility and payment terms agreement",
  "purpose": "Establish financial agreement between patient and practice",
  "effectivePeriod": {
    "start": "2025-10-22"
  },
  "item": [
    {
      "linkId": "section-payment",
      "text": "Payment Responsibility",
      "type": "group",
      "required": true,
      "item": [
        {
          "linkId": "1.1",
          "text": "Financial Responsibility Statement",
          "type": "display",
          "text": "I understand that I am financially responsible for all charges regardless of insurance coverage. I agree to pay my portion of the bill at the time of service or upon receipt of statement."
        },
        {
          "linkId": "1.2",
          "text": "I acknowledge and accept financial responsibility",
          "type": "boolean",
          "required": true
        },
        {
          "linkId": "1.3",
          "text": "Who is responsible for payment?",
          "type": "choice",
          "required": true,
          "answerOption": [
            { "valueCoding": { "code": "self", "display": "Self" } },
            { "valueCoding": { "code": "spouse", "display": "Spouse/Partner" } },
            { "valueCoding": { "code": "parent", "display": "Parent/Guardian" } },
            { "valueCoding": { "code": "other", "display": "Other" } }
          ]
        },
        {
          "linkId": "1.4",
          "text": "If other, please specify name and relationship",
          "type": "string",
          "required": false,
          "enableWhen": [
            {
              "question": "1.3",
              "operator": "=",
              "answerCoding": { "code": "other" }
            }
          ]
        }
      ]
    },
    {
      "linkId": "section-insurance",
      "text": "Insurance Authorization",
      "type": "group",
      "required": true,
      "item": [
        {
          "linkId": "2.1",
          "text": "Insurance Assignment Statement",
          "type": "display",
          "text": "I authorize Greenway Health to file claims with my insurance company and request that payment be made directly to the practice. I authorize the release of any medical information necessary to process insurance claims."
        },
        {
          "linkId": "2.2",
          "text": "I authorize insurance filing and information release",
          "type": "boolean",
          "required": true
        },
        {
          "linkId": "2.3",
          "text": "I understand I am responsible for co-pays, deductibles, and non-covered services",
          "type": "boolean",
          "required": true
        }
      ]
    },
    {
      "linkId": "section-payment-methods",
      "text": "Payment Methods",
      "type": "group",
      "required": true,
      "item": [
        {
          "linkId": "3.1",
          "text": "Payment Methods Information",
          "type": "display",
          "text": "We accept: Cash, Check, Credit Cards (Visa, MasterCard, Discover, American Express), Debit Cards, and HSA/FSA cards. Payment plans may be available for balances over $500."
        },
        {
          "linkId": "3.2",
          "text": "Would you like to set up a payment plan for balances over $500?",
          "type": "choice",
          "required": false,
          "answerOption": [
            { "valueCoding": { "code": "yes", "display": "Yes, I'm interested" } },
            { "valueCoding": { "code": "no", "display": "No, I will pay in full" } },
            { "valueCoding": { "code": "later", "display": "I'll decide later" } }
          ]
        }
      ]
    },
    {
      "linkId": "section-signature",
      "text": "Signature",
      "type": "group",
      "required": true,
      "item": [
        {
          "linkId": "4.1",
          "text": "Full Name (Electronic Signature)",
          "type": "string",
          "required": true
        },
        {
          "linkId": "4.2",
          "text": "Date",
          "type": "date",
          "required": true
        },
        {
          "linkId": "4.3",
          "text": "By typing my name above, I acknowledge this constitutes my legal electronic signature",
          "type": "boolean",
          "required": true
        }
      ]
    }
  ]
}
